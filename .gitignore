# Dependencies
node_modules/

# Generated at install time by scripts/vendor.js (npm postinstall)
www/vendor/

# Self-test artifacts (regenerated by npm run selftest)
tests/screenshots/
tests/fixtures/*.wav

# Saywell user data that must never be committed
*.swbk
saywell-export-*.md
saywell-export-*.json
saywell-recovery-code.txt

# Secrets & local config
.env
.env.*
*.pem
*.keystore
*.jks

# Builds
dist/
out/
ios/App/Pods/
ios/App/App/public/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
